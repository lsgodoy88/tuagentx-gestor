generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id                          String                @id @default(cuid())
  nombre                      String
  email                       String                @unique
  password                    String
  plan                        String                @default("basico")
  activo                      Boolean               @default(true)
  maxSupervisores             Int                   @default(1)
  maxVendedores               Int                   @default(1)
  maxEntregas                 Int                   @default(0)
  maxBodega                   Int                   @default(0)
  maxImpulsadoras             Int                   @default(0)
  createdAt                   DateTime              @default(now())
  planFin                     DateTime?             @db.Timestamp(6)
  telefono                    String?               @db.VarChar(20)
  modoEquipo                  String?
  horaInicioRuta              String                @default("06:00")
  horaFinRuta                 String                @default("20:00")
  autoCrearRuta               Boolean               @default(false)
  autoCerrarRuta              Boolean               @default(false)
  autoAbrirTurno              Boolean               @default(false)
  autoCerrarTurno             Boolean               @default(false)
  diasCrearRuta               String                @default("0,1,2,3,4")
  diasCerrarRuta              String                @default("0,1,2,3,4")
  ciudadEntregaLocal          String?
  diasHistorialBodega         Int                   @default(7)
  bodegaPuedeEnviar           Boolean               @default(false)
  syncVentasHoy               Int?                  @default(0)
  syncVentasFecha             DateTime?
  syncVentasUltimo            DateTime?
  ultimaSyncBodega            DateTime?
  configRecibos               Json?                 @default("{\"nit\": null, \"logo\": null, \"prefijo\": \"REC\", \"telefono\": null, \"direccion\": null, \"anchoPapel\": \"80mm\"}")
  colorFondo                  String?
  configDespachos             Json?                 @default("{\"urlBase\": \"\", \"transportadora\": \"\"}")
  limite_storage_gb           Int                   @default(1)
  ultimaSyncClientes          DateTime?
  sync_cursor_clientes        Json?
  sync_cursor_empleados       Json?
  sync_cursor_productos       Json?
  sync_cursor_cartera         Json?
  sync_cursor_cartera_update  Json?
  sync_cursor_listas          Json?
  sync_cursor_proveedores     Json?
  montoNegociado              Int?
  negociadoAt                 DateTime?             @db.Timestamp(6)
  creditoSaldo                Int                   @default(0)
  fechaInicioBodega           DateTime?             @db.Timestamp(6)
  sync_cursor_ordenes_date    Json?
  sync_cursor_ordenes_deleted Json?
  chatsAsistente              AsistenteChat[]
  Cartera                     Cartera[]
  CarteraCache                CarteraCache[]
  carteraEdadSnapshots        CarteraEdadSnapshot[]
  clientes                    Cliente[]
  comisionCalculos            ComisionCalculo[]
  comisionConfigs             ComisionConfig[]
  despachoLogs                DespachoLog[]         @relation("DespachoLogEmpresa")
  egresos                     Egreso[]
  egresosCategorias           EgresoCategoria[]
  empleados                   Empleado[]
  vinculadas                  EmpresaVinculada[]
  gastos                      Gasto[]
  gastoTipos                  GastoTipo[]
  impulsoInventarios          ImpulsoInventario[]
  integraciones               Integracion[]
  mediaCarpetas               MediaCarpeta[]
  mediaConfig                 MediaConfig?
  metasRecaudo                MetaRecaudo[]
  metasVenta                  MetaVenta[]
  ordenesDespacho             OrdenDespacho[]
  productos                   Producto[]
  reportesImpulsoMes          ReporteImpulsoMes[]
  rutas                       Ruta[]
  rutasFijas                  RutaFija[]
  smsConfig                   SmsConfig?
  smsLogs                     SmsLog[]
  snapshotsMes                SnapshotMes[]
  stockSnapshots              StockSnapshot[]
  subEmpresas                 SubEmpresa[]
  transprensaRemesas          TransprensaRemesa[]
  ventasMes                   VentaMesCliente[]
}

model Empleado {
  id                        String               @id @default(cuid())
  nombre                    String
  email                     String               @unique
  password                  String
  telefono                  String?
  rol                       String               @default("vendedor")
  activo                    Boolean              @default(true)
  vendedorId                String?
  empresaId                 String
  createdAt                 DateTime             @default(now())
  puedeCapturarGps          Boolean              @default(false)
  ciudades                  String[]             @default([])
  permisos                  Json?                @default("{}")
  etiqueta                  String?
  uptresEmail               String?
  uptresPassword            String?
  apiId                     String?
  metaVenta                 Float?
  documento                 String?
  tipoDocumento             String?
  direccionUptres           String?
  departamento              String?
  ciudadApiId               String?
  fechaNacimiento           DateTime?
  subEmpresaId              String?
  configRecibos             Json?                @default("{\"prefijo\": null, \"anchoPapel\": null, \"consecutivoMes\": null, \"consecutivoActual\": 0, \"usarConfigEmpresa\": true}")
  colorFondo                String?
  syncInicioAt              DateTime?
  syncDeudas                Int?
  Cartera                   Cartera[]
  comisionConfigs           ComisionConfig[]
  DetalleCartera            DetalleCartera[]
  empresa                   Empresa              @relation(fields: [empresaId], references: [id])
  subEmpresa                SubEmpresa?          @relation(fields: [subEmpresaId], references: [id])
  listasAsignadas           EmpleadoLista[]
  gastos                    Gasto[]
  impulsoInventarioEmpleado ImpulsoInventario[]  @relation("ImpulsoInventarioEmpleado")
  impulsoInventarioVendedor ImpulsoInventario[]  @relation("ImpulsoInventarioVendedor")
  metasRecaudo              MetaRecaudo[]
  metasVenta                MetaVenta[]
  ordenesAlistadas          OrdenDespacho[]      @relation("AlistadoPor")
  ordenesRepartidas         OrdenDespacho[]      @relation("RepartidorDespacho")
  PagoCartera               PagoCartera[]
  rutas                     RutaEmpleado[]
  rutasFijas                RutaFijaEmpleado[]
  vendedoresAsignados       SupervisorVendedor[] @relation("SupervisorVendedores")
  supervisorAsignado        SupervisorVendedor[] @relation("VendedorSupervisor")
  turnos                    Turno[]
  visitas                   Visita[]
  visitaResumenes           VisitaResumen[]

  @@index([empresaId, activo], map: "idx_empleado_empresa_activo")
  @@map("Empleado")
}

model SupervisorVendedor {
  supervisorId String
  vendedorId   String
  supervisor   Empleado @relation("SupervisorVendedores", fields: [supervisorId], references: [id])
  vendedor     Empleado @relation("VendedorSupervisor", fields: [vendedorId], references: [id])

  @@id([supervisorId, vendedorId])
  @@map("SupervisorVendedor")
}

model Cliente {
  id                 String              @id @default(cuid())
  nombre             String
  nombreComercial    String?
  direccion          String?
  telefono           String?
  email              String?
  lat                Float?
  lng                Float?
  ubicacionReal      Boolean             @default(false)
  empresaId          String
  subEmpresaId       String?
  createdAt          DateTime            @default(now())
  creadoEnBogota     DateTime?
  metaVenta          Float?
  nit                String?             @db.VarChar(255)
  ciudad             String?             @db.VarChar(255)
  departamento       String?             @db.VarChar(255)
  listaId            String?
  apiId              String?
  maps               String?
  latTmp             Float?
  lngTmp             Float?
  Cartera            Cartera[]
  empresa            Empresa             @relation(fields: [empresaId], references: [id])
  lista              ListaClientes?      @relation(fields: [listaId], references: [id])
  subEmpresa         SubEmpresa?         @relation(fields: [subEmpresaId], references: [id])
  clienteListas      ClienteLista[]
  impulsoInventarios ImpulsoInventario[]
  rutaClientes       RutaCliente[]
  rutasFijas         RutaFijaCliente[]
  ventasMes          VentaMesCliente[]
  visitas            Visita[]

  @@index([empresaId], map: "idx_cliente_empresa")
  @@index([listaId], map: "idx_cliente_lista")
  @@index([nit], map: "idx_cliente_nit")
  @@index([nombre], map: "idx_cliente_nombre")
  @@map("Cliente")
}

model Turno {
  id               String    @id @default(cuid())
  empleadoId       String
  inicio           DateTime  @default(now())
  fin              DateTime?
  latInicio        Float?
  lngInicio        Float?
  latFin           Float?
  lngFin           Float?
  activo           Boolean   @default(true)
  pausado          Boolean   @default(false)
  pausaInicio      DateTime?
  pausaMotivo      String?
  pausaDuracionMin Int?
  inicioBogota     String?
  finBogota        String?
  pausaFin         DateTime?
  pausaFinBogota   String?
  empleado         Empleado  @relation(fields: [empleadoId], references: [id])
  visitas          Visita[]

  @@index([empleadoId], map: "idx_turno_empleado")
  @@index([empleadoId, activo], map: "idx_turno_empleado_activo")
  @@map("Turno")
}

model Visita {
  id                 String         @id @default(cuid())
  empleadoId         String
  clienteId          String
  turnoId            String?
  lat                Float?
  lng                Float?
  nota               String?
  foto               String?
  tipo               String         @default("visita")
  monto              Float?
  fechaBogota        DateTime?
  esLibre            Boolean        @default(false)
  factura            String?
  firma              String?
  rutaFijaClienteId  String?
  ordenDespachoId    String?
  createdAt          DateTime       @default(now())
  clienteNombreLibre String?
  cliente            Cliente        @relation(fields: [clienteId], references: [id])
  empleado           Empleado       @relation(fields: [empleadoId], references: [id])
  ordenDespacho      OrdenDespacho? @relation(fields: [ordenDespachoId], references: [id])
  turno              Turno?         @relation(fields: [turnoId], references: [id])

  @@index([empleadoId], map: "idx_visita_empleado")
  @@index([empleadoId, clienteId], map: "idx_visita_empleado_cliente")
  @@index([createdAt], map: "idx_visita_fecha")
  @@index([fechaBogota], map: "idx_visita_fecha_bogota")
  @@index([fechaBogota], map: "idx_visita_fechabogota")
  @@index([turnoId])
  @@map("Visita")
}

model VisitaResumen {
  id               String   @id @default(cuid())
  empleadoId       String
  granularidad     String
  fecha            String
  total            Int      @default(0)
  visitas          Int      @default(0)
  ventas           Int      @default(0)
  cobros           Int      @default(0)
  entregas         Int      @default(0)
  montoVentas      Float    @default(0)
  montoCobros      Float    @default(0)
  actualizadoEn    DateTime @updatedAt
  monto_descuentos Float    @default(0)
  empleado         Empleado @relation(fields: [empleadoId], references: [id])

  @@unique([empleadoId, granularidad, fecha])
  @@index([empleadoId, granularidad, fecha])
  @@map("VisitaResumen")
}

model Ruta {
  id                 String            @id @default(cuid())
  nombre             String
  fecha              DateTime?
  empresaId          String
  subEmpresaId       String?
  empresaVinculadaId String?
  createdAt          DateTime          @default(now())
  cerrada            Boolean           @default(false)
  cerradaEl          DateTime?
  iniciada           Boolean           @default(false)
  empresa            Empresa           @relation(fields: [empresaId], references: [id])
  empresaVinculada   EmpresaVinculada? @relation(fields: [empresaVinculadaId], references: [id])
  subEmpresa         SubEmpresa?       @relation(fields: [subEmpresaId], references: [id])
  clientes           RutaCliente[]
  empleados          RutaEmpleado[]

  @@index([empresaId], map: "idx_ruta_empresa")
  @@index([empresaId, fecha, cerrada])
  @@map("Ruta")
}

model RutaEmpleado {
  id         String   @id @default(cuid())
  rutaId     String
  empleadoId String
  empleado   Empleado @relation(fields: [empleadoId], references: [id])
  ruta       Ruta     @relation(fields: [rutaId], references: [id])

  @@index([empleadoId])
  @@map("RutaEmpleado")
}

model RutaCliente {
  id                 String    @id @default(cuid())
  rutaId             String
  clienteId          String
  orden              Int       @default(0)
  rezago             Boolean   @default(false)
  asignadoEn         DateTime  @default(now())
  supervisorId       String?
  supervisorEtiqueta String?
  notas              String?
  ejecutado          Boolean   @default(false)
  posible_entrega    DateTime? @db.Date
  cliente            Cliente   @relation(fields: [clienteId], references: [id])
  ruta               Ruta      @relation(fields: [rutaId], references: [id])

  @@index([rutaId], map: "idx_rutacliente_ruta")
  @@map("RutaCliente")
}

model RutaFija {
  id             String             @id @default(cuid())
  nombre         String
  diaSemana      Int
  empresaId      String
  subEmpresaId   String?
  createdAt      DateTime           @default(now())
  priorizableHoy Boolean            @default(false)
  empresa        Empresa            @relation(fields: [empresaId], references: [id])
  subEmpresa     SubEmpresa?        @relation(fields: [subEmpresaId], references: [id])
  clientes       RutaFijaCliente[]
  empleados      RutaFijaEmpleado[]

  @@map("RutaFija")
}

model RutaFijaEmpleado {
  id         String   @id @default(cuid())
  rutaFijaId String
  empleadoId String
  empleado   Empleado @relation(fields: [empleadoId], references: [id])
  rutaFija   RutaFija @relation(fields: [rutaFijaId], references: [id])

  @@index([empleadoId])
  @@map("RutaFijaEmpleado")
}

model RutaFijaCliente {
  id          String   @id @default(cuid())
  rutaFijaId  String
  clienteId   String
  orden       Int      @default(0)
  metaVenta   Float?
  latImpulso  Float?
  lngImpulso  Float?
  latVendedor Float?
  lngVendedor Float?
  horaEntrada String?
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  rutaFija    RutaFija @relation(fields: [rutaFijaId], references: [id])

  @@map("RutaFijaCliente")
}

model VentaMesCliente {
  id              String   @id @default(cuid())
  clienteId       String
  empresaId       String
  mes             String
  totalVenta      Float    @default(0)
  cantidadVisitas Int      @default(0)
  updatedAt       DateTime @updatedAt
  cliente         Cliente  @relation(fields: [clienteId], references: [id])
  empresa         Empresa  @relation(fields: [empresaId], references: [id])

  @@unique([clienteId, mes])
  @@index([empresaId, mes])
  @@index([clienteId, mes], map: "idx_ventamescliente_cliente")
  @@map("VentaMesCliente")
}

model AuditLog {
  id         String   @id @default(cuid())
  accion     String
  usuario    String?
  detalle    String?
  empleadoId String?
  empresaId  String?
  ip         String?
  createdAt  DateTime @default(now())

  @@map("AuditLog")
}

model PrecioRol {
  id        String   @id @default(cuid())
  rol       String   @unique
  precio    Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("PrecioRol")
}

model ListaClientes {
  id            String          @id @default(cuid())
  nombre        String
  empresaId     String
  createdAt     DateTime?       @default(now()) @db.Timestamp(6)
  api_id        String?         @unique
  name_us       String?
  clientes      Cliente[]
  clienteListas ClienteLista[]
  vendedores    EmpleadoLista[]

  @@map("ListaClientes")
}

model Proveedor {
  id                   String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  api_id               String?   @unique
  empresaId            String
  firstName            String
  lastName             String?
  document             String?
  documentType         String?
  verificationDigit    String?
  email                String?
  phone                String?
  cityId               String?
  address              String?
  neighborhood         String?
  note                 String?
  condition            Boolean   @default(true)
  createdAt            DateTime  @default(now()) @db.Timestamp(6)
  updatedAt            DateTime? @db.Timestamp(6)
  aplica_retencion     Boolean   @default(false)
  porcentaje_retencion Decimal?  @db.Decimal(5, 2)
  banco                String?
  numero_cuenta        String?
  whatsapp             String?

  @@map("Proveedor")
}

model ClienteLista {
  clienteId String
  listaId   String
  cliente   Cliente       @relation(fields: [clienteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lista     ListaClientes @relation(fields: [listaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([clienteId, listaId])
  @@map("ClienteLista")
}

model EmpleadoLista {
  empleadoId String
  listaId    String
  empleado   Empleado      @relation(fields: [empleadoId], references: [id])
  lista      ListaClientes @relation(fields: [listaId], references: [id])

  @@id([empleadoId, listaId])
  @@map("EmpleadoLista")
}

model AsistenteChat {
  id        String    @id @default(cuid())
  empresaId String
  rol       String
  texto     String
  creadoEn  DateTime? @default(now()) @db.Timestamp(6)
  empresa   Empresa   @relation(fields: [empresaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Cartera {
  id             String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  clienteId      String
  empresaId      String
  saldoTotal     Decimal?         @default(0) @db.Decimal(12, 2)
  saldoPendiente Decimal?         @default(0) @db.Decimal(12, 2)
  fuente         String?          @default("manual")
  updatedAt      DateTime?        @default(now()) @db.Timestamp(6)
  createdAt      DateTime?        @default(now()) @db.Timestamp(6)
  celular        String?
  empleadoId     String?
  Cliente        Cliente          @relation(fields: [clienteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Empleado       Empleado?        @relation(fields: [empleadoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Empresa        Empresa          @relation(fields: [empresaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  DetalleCartera DetalleCartera[]
  PagoCartera    PagoCartera[]
}

model DetalleCartera {
  id               String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  carteraId        String
  numeroFactura    String?
  valor            Decimal   @db.Decimal(12, 2)
  fechaVencimiento DateTime? @db.Date
  estado           String?   @default("pendiente")
  createdAt        DateTime? @default(now()) @db.Timestamp(6)
  celular          String?
  concepto         String?
  valorFactura     Decimal?  @db.Decimal(12, 2)
  abonos           Decimal?  @default(0) @db.Decimal(12, 2)
  empleadoId       String?
  Cartera          Cartera   @relation(fields: [carteraId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Empleado         Empleado? @relation(fields: [empleadoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model PagoCartera {
  id                 String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  carteraId          String?
  empleadoId         String
  monto              Decimal            @db.Decimal(12, 2)
  descuento          Decimal?           @default(0) @db.Decimal(12, 2)
  tipo               String?            @default("abono")
  metodopago         String?            @default("efectivo")
  notas              String?
  reciboUrl          String?
  createdAt          DateTime?          @default(now()) @db.Timestamp(6)
  numeroRecibo       String?
  reciboToken        String?            @unique
  tokenExpira        DateTime?
  voucherKey         String?
  voucherDatosIA     Json?
  fechaPago          DateTime?
  saldoAnterior      Decimal?           @db.Decimal(14, 2)
  numeroFactura      Int?
  clienteApiId       String?
  clienteNombre      String?
  valorFactura       Decimal?           @db.Decimal(14, 2)
  vendedorNombre     String?
  reciboPago         Json?
  lineasPago         Json?
  latCobro           Float?
  lngCobro           Float?
  gpsAccuracy        Float?
  syncDeudaId        String?
  idempotencyKey     String?            @unique
  envioEstado        String             @default("pendiente")
  envioFecha         DateTime?
  envioRef           String?
  envioVariacion     Json?
  receivableAtUptres DateTime?
  alertaVoucher      String?
  Cartera            Cartera?           @relation(fields: [carteraId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Empleado           Empleado           @relation(fields: [empleadoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Aplicaciones       PagoCarteraDeuda[]

  @@index([empleadoId])
  @@index([syncDeudaId])
  @@index([empleadoId, createdAt(sort: Desc)])
}

model PagoCarteraDeuda {
  id                 String      @id @default(cuid())
  pagoId             String
  syncDeudaId        String
  numeroFactura      Int?
  externalId         String?
  montoAplicado      Decimal     @db.Decimal(14, 2)
  descuento          Decimal?    @db.Decimal(10, 2)
  createdAt          DateTime    @default(now())
  envioEstado        String      @default("pendiente")
  envioFecha         DateTime?
  receivableAtUptres DateTime?
  PagoCartera        PagoCartera @relation(fields: [pagoId], references: [id], onDelete: Cascade)

  @@index([pagoId])
  @@index([syncDeudaId])
  @@map("PagoCarteraDeuda")
}

model PushSuscripcion {
  id         String   @id
  empleadoId String
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())
  user_agent String?

  @@index([empleadoId])
}

model nc_api_tokens {
  id               Int       @id @default(autoincrement())
  base_id          String?   @db.VarChar(20)
  db_alias         String?   @db.VarChar(255)
  description      String?   @db.VarChar(255)
  permissions      String?
  token            String?
  expiry           String?   @db.VarChar(255)
  enabled          Boolean?  @default(true)
  fk_user_id       String?   @db.VarChar(20)
  fk_workspace_id  String?   @db.VarChar(20)
  fk_sso_client_id String?   @db.VarChar(20)
  created_at       DateTime? @db.Timestamptz(6)
  updated_at       DateTime? @db.Timestamptz(6)

  @@index([fk_sso_client_id], map: "nc_api_tokens_fk_sso_client_id_index")
  @@index([fk_user_id], map: "nc_api_tokens_fk_user_id_index")
}

model nc_audit_v2 {
  id              String   @id(map: "nc_audit_v2_pkx") @db.Uuid
  user            String?  @db.VarChar(255)
  ip              String?  @db.VarChar(255)
  source_id       String?  @db.VarChar(20)
  base_id         String?  @db.VarChar(20)
  fk_model_id     String?  @db.VarChar(20)
  row_id          String?  @db.VarChar(255)
  op_type         String?  @db.VarChar(255)
  op_sub_type     String?  @db.VarChar(255)
  status          String?  @db.VarChar(255)
  description     String?
  details         String?
  fk_user_id      String?  @db.VarChar(20)
  fk_ref_id       String?  @db.VarChar(20)
  fk_parent_id    String?  @db.Uuid
  fk_workspace_id String?  @db.VarChar(20)
  fk_org_id       String?  @db.VarChar(20)
  user_agent      String?
  version         Int?     @default(0) @db.SmallInt
  old_id          String?  @db.VarChar(20)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([fk_workspace_id], map: "nc_audit_v2_fk_workspace_idx")
